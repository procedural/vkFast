#!/bin/bash

cd ..

for dir in */; do
  (
    cd "$dir" || exit
    pwd
    chmod +x main.c
    chmod +x main.cpp
    ./main.c
    main_c_success=$?
    ./main.cpp
    main_cpp_success=$?
    chmod -x main.c
    chmod -x main.cpp
    if [ "$main_c_success" -eq 0 ] || [ "$main_cpp_success" -eq 0 ]; then
      printf "\e[97;42m Success \e[0m \n"
    else
      printf "\e[97;41m Fail \e[0m \n"
      exit 1
    fi
  ) || exit 1
done
